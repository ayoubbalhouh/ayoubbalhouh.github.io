{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"palette": [
				{ "slug": "base", "name": "Crema", "color": "#f8f4ec" },
				{ "slug": "base-2", "name": "Lino", "color": "#efe7d8" },
				{ "slug": "contrast", "name": "Inchiostro", "color": "#2a2a22" },
				{ "slug": "muted", "name": "Pietra", "color": "#6f6a5e" },
				{ "slug": "primary", "name": "Oliva", "color": "#5b6b3a" },
				{ "slug": "secondary", "name": "Terracotta", "color": "#b5563a" }
			]
		},
		"layout": { "contentSize": "720px", "wideSize": "1200px" },
		"spacing": {
			"units": ["px", "em", "rem", "%", "vw", "vh"],
			"spacingSizes": [
				{ "slug": "20", "name": "XS", "size": "0.5rem" },
				{ "slug": "30", "name": "S", "size": "1rem" },
				{ "slug": "40", "name": "M", "size": "clamp(1.25rem, 2vw, 1.75rem)" },
				{ "slug": "50", "name": "L", "size": "clamp(2rem, 4vw, 3rem)" },
				{ "slug": "60", "name": "XL", "size": "clamp(3rem, 7vw, 6rem)" }
			]
		},
		"typography": {
			"fluid": true,
			"fontFamilies": [
				{ "slug": "heading", "name": "Fraunces", "fontFamily": "\"Fraunces\", Georgia, serif" },
				{ "slug": "body", "name": "Inter", "fontFamily": "\"Inter\", system-ui, -apple-system, sans-serif" }
			],
			"fontSizes": [
				{ "slug": "small", "name": "Piccolo", "size": "0.875rem" },
				{ "slug": "medium", "name": "Medio", "size": "1.0625rem" },
				{ "slug": "large", "name": "Grande", "size": "1.375rem", "fluid": { "min": "1.2rem", "max": "1.375rem" } },
				{ "slug": "x-large", "name": "Molto grande", "size": "2.25rem", "fluid": { "min": "1.75rem", "max": "2.25rem" } },
				{ "slug": "xx-large", "name": "Enorme", "size": "4rem", "fluid": { "min": "2.5rem", "max": "4rem" } }
			]
		},
		"custom": { "radius": "18px" }
	},
	"styles": {
		"color": { "background": "var:preset|color|base", "text": "var:preset|color|contrast" },
		"typography": { "fontFamily": "var:preset|font-family|body", "fontSize": "var:preset|font-size|medium", "lineHeight": "1.65" },
		"spacing": {
			"blockGap": "1.25rem",
			"padding": { "left": "var:preset|spacing|40", "right": "var:preset|spacing|40" }
		},
		"elements": {
			"heading": {
				"typography": { "fontFamily": "var:preset|font-family|heading", "fontWeight": "500", "lineHeight": "1.1", "letterSpacing": "-0.01em" }
			},
			"h1": { "typography": { "fontSize": "var:preset|font-size|xx-large" } },
			"h2": { "typography": { "fontSize": "var:preset|font-size|x-large" } },
			"h3": { "typography": { "fontSize": "var:preset|font-size|large" } },
			"link": {
				"color": { "text": "var:preset|color|primary" },
				":hover": { "color": { "text": "var:preset|color|secondary" } }
			},
			"button": {
				"color": { "background": "var:preset|color|contrast", "text": "var:preset|color|base" },
				"border": { "radius": "999px" },
				"spacing": { "padding": { "top": "0.85em", "bottom": "0.85em", "left": "1.6em", "right": "1.6em" } },
				"typography": { "fontWeight": "600", "fontSize": "var:preset|font-size|small" },
				":hover": { "color": { "background": "var:preset|color|primary" } },
				":focus": { "outline": { "color": "var:preset|color|secondary", "offset": "3px", "style": "solid", "width": "2px" } }
			},
			"caption": { "color": { "text": "var:preset|color|muted" }, "typography": { "fontSize": "var:preset|font-size|small" } }
		},
		"blocks": {
			"core/site-title": { "typography": { "fontFamily": "var:preset|font-family|heading", "fontSize": "1.6rem", "fontWeight": "500" } },
			"core/navigation": { "typography": { "fontSize": "var:preset|font-size|small", "fontWeight": "500" } },
			"core/post-featured-image": { "border": { "radius": "var:custom|radius" } },
			"core/image": { "border": { "radius": "var:custom|radius" } },
			"core/quote": {
				"border": { "left": { "color": "var:preset|color|secondary", "width": "3px" } },
				"typography": { "fontFamily": "var:preset|font-family|heading", "fontSize": "1.3rem", "lineHeight": "1.45" }
			},
			"core/separator": { "color": { "text": "var:preset|color|base-2" } }
		}
	},
	"templateParts": [
		{ "name": "header", "title": "Intestazione", "area": "header" },
		{ "name": "footer", "title": "Piè di pagina", "area": "footer" }
	],
	"customTemplates": [
		{ "name": "page-senza-titolo", "title": "Pagina senza titolo", "postTypes": ["page"] }
	]
}
